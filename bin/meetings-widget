#!/usr/bin/env python3
"""meetings-widget: the day's agenda as JSON for the bar widget.

    meetings-widget day             # today
    meetings-widget day 1           # tomorrow, -1 is yesterday
    meetings-widget day 0 --only "Someone Else"   # that one calendar only
    meetings-widget week            # this week, Monday through Sunday
    meetings-widget week -1         # last week
    meetings-widget week --demo     # a made-up week, no gcalcli needed

Reads Google Calendar through gcalcli, Outlook Calendar through the CLI for
Microsoft 365, or an iCalendar file/feed. Every provider is normalized to the
same rows before layout.

Python rather than a shell script because the work here is dates, overlap and
JSON, and rather than Ruby because gcalcli is itself a Python program: anyone
who can run this plugin already has the interpreter it needs.
"""

import json
import os
import re
import shutil
import subprocess
import sys
import threading
from datetime import date, datetime, time, timedelta, timezone
from urllib.error import URLError
from urllib.request import urlopen
from urllib.parse import quote, urlencode, urlsplit
from zoneinfo import ZoneInfo, ZoneInfoNotFoundError

ARGV = sys.argv[1:]


def home_path(env_name, fallback, *parts):
    base = os.environ.get(env_name) or os.path.join(os.path.expanduser("~"), fallback)
    return os.path.join(base, *parts)


# Which calendar gets which colour is personal, so it lives in a config file
# instead of in here. A bar plugin cannot count on the environment reaching it,
# so a file is the only thing it can rely on; the env vars stay behind as an
# override for running this from a shell.
CONFIG_PATH = os.environ.get("MEETINGS_CONFIG") or home_path(
    "XDG_CONFIG_HOME", ".config", "omarchy-meetings", "config.json")


def read_json(path, default):
    try:
        with open(path, "r") as handle:
            return json.load(handle)
    except (OSError, ValueError):
        return default


CONFIG = read_json(CONFIG_PATH, {})
if not isinstance(CONFIG, dict):
    CONFIG = {}


def provider_name(value):
    name = str(value or "").strip().lower()
    if name in ("microsoft", "microsoft365", "m365", "outlook"):
        return "microsoft"
    if name in ("ical", "icalendar", "ics"):
        return "ical"
    return "google"


# Google stays the default, so existing installs need no config change. The
# environment override is useful for trying the other adapter from a terminal.
PROVIDER = provider_name(os.environ.get("MEETINGS_PROVIDER") or CONFIG.get("provider"))

_ical_source = os.environ.get("MEETINGS_ICAL_PATH") or CONFIG.get("icalPath") or ""
ICAL_PATH = os.path.expanduser(str(_ical_source)).strip()


def local_timezone_name():
    candidates = [os.environ.get("TZ")]
    try:
        zone_path = os.path.realpath("/etc/localtime")
        marker = "/zoneinfo/"
        if marker in zone_path:
            candidates.append(zone_path.split(marker, 1)[1])
    except OSError:
        pass
    for candidate in candidates:
        if not candidate:
            continue
        try:
            ZoneInfo(candidate)
            return candidate
        except (ValueError, ZoneInfoNotFoundError):
            continue
    return "UTC"


LOCAL_TIMEZONE = local_timezone_name()

DEMO = ("--demo" in ARGV
        or os.environ.get("MEETINGS_DEMO") == "1"
        or CONFIG.get("demo") is True)

# What the panel remembers between openings: which calendars are ticked and
# whether you left it on the week or the day. It sits next to the config rather
# than in it, because this file is rewritten from the panel and rewriting the
# config would throw away whatever the reader put in there by hand.
STATE_PATH = os.path.join(os.path.dirname(CONFIG_PATH), "state.json")

STATE = read_json(STATE_PATH, {})
if not isinstance(STATE, dict):
    STATE = {}

# Absent means everything is shown, which is what a fresh install should do.
_visible = STATE.get("visibleCalendars")
VISIBLE = [str(name) for name in _visible] if isinstance(_visible, list) and _visible else None

# The week is the default: it says more at a glance, and it is what you get
# before you have ever chosen otherwise.
VIEW = "day" if STATE.get("view") == "day" else "week"


# gcalcli stores its token here, and without one it starts an interactive auth
# flow of its own. A bar widget that refreshes every minute must never do that,
# so the token is checked before gcalcli is called at all.
GCALCLI_OAUTH = home_path("XDG_DATA_HOME", ".local/share", "gcalcli", "oauth")


# Everything a CLI hands back is read through one ceiling, in bytes and in
# seconds. A week of calendar data is kilobytes, so the ceiling is generous;
# it exists because an answer past it means the source is broken or hostile,
# and half an answer must never be parsed as if it were whole. Overflow and
# timeout therefore both read as failure, never as data.
MAX_CLI_BYTES = 8 * 1024 * 1024
CLI_TIMEOUT_SECONDS = 90
# A feed is one request rather than a program that has to start first, so it
# gets a shorter leash than the CLIs do.
ICAL_TIMEOUT_SECONDS = 10


def run_capped(command, timeout=CLI_TIMEOUT_SECONDS):
    """Run a non-interactive CLI and hand back its stdout, or None."""
    try:
        proc = subprocess.Popen(command, stdout=subprocess.PIPE,
                                stderr=subprocess.DEVNULL,
                                stdin=subprocess.DEVNULL)
    except OSError:
        return None
    timer = threading.Timer(timeout, proc.kill)
    timer.start()
    try:
        data = proc.stdout.read(MAX_CLI_BYTES + 1)
        overflow = len(data) > MAX_CLI_BYTES
        if overflow:
            proc.kill()
        proc.stdout.close()
        status = proc.wait()
    finally:
        timer.cancel()
    if overflow or status != 0:
        return None
    return data.decode("utf-8", "replace")


def run_json(command):
    """Run a non-interactive CLI command and decode its JSON answer."""
    out = run_capped(command)
    if out is None:
        return None
    try:
        return json.loads(out)
    except (TypeError, ValueError):
        return None


_m365_status = None
_m365_status_checked = False


def m365_status():
    global _m365_status, _m365_status_checked
    if not _m365_status_checked:
        _m365_status = run_json(["m365", "status", "--output", "json"])
        _m365_status_checked = True
    return _m365_status


def authenticated():
    if PROVIDER == "microsoft":
        status = m365_status()
        return isinstance(status, dict) and bool(status.get("connectedAs"))
    if PROVIDER == "ical":
        return bool(ICAL_PATH)
    return os.path.isfile(GCALCLI_OAUTH)


def required_command():
    if PROVIDER == "microsoft":
        return "m365"
    if PROVIDER == "google":
        return "gcalcli"
    return None


def provider_payload():
    if PROVIDER == "microsoft":
        return {
            "provider": "microsoft",
            "provider_label": "Outlook Calendar",
            "agenda_url": "https://outlook.office.com/calendar/view/week",
        }
    if PROVIDER == "ical":
        return {
            "provider": "ical",
            "provider_label": "iCalendar",
            "agenda_url": "",
        }
    return {
        "provider": "google",
        "provider_label": "Google Calendar",
        "agenda_url": "",
    }


def private_dir(path):
    """The directory holds what your days look like, so it is nobody else's to
    read. makedirs follows a symlink and reports success, so check the path."""
    try:
        if not os.path.isdir(path):
            os.makedirs(path, mode=0o700, exist_ok=True)
        if os.path.islink(path):
            return False
        if os.stat(path).st_uid != os.getuid():
            return False
        os.chmod(path, 0o700)
        return True
    except OSError:
        return False


def write_private(path, content):
    """rename replaces the path, where `>` would follow a symlink sitting on it."""
    directory = os.path.dirname(path)
    if not private_dir(directory):
        return False

    tmp = "%s.%d.tmp" % (path, os.getpid())
    try:
        handle = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(handle, "w") as out:
            out.write(content)
        os.rename(tmp, path)
        return True
    except OSError:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        return False


_skip_env = os.environ.get("MEETINGS_SKIP_CALENDARS")
SKIP_CALENDARS = [name.strip() for name in (
    _skip_env.split(",") if _skip_env is not None else (CONFIG.get("skipCalendars") or []))]

# --only turns the filter around: that one calendar becomes the only thing that
# counts. Meant for glancing at someone else's day without your own agenda in
# between, so the skip list does not apply.
ONLY_CALENDAR = None
if "--only" in ARGV:
    _index = ARGV.index("--only")
    if _index + 1 < len(ARGV):
        ONLY_CALENDAR = ARGV[_index + 1]

SKIP_TITLES = CONFIG.get("skipTitles") or []

# Colour and order per calendar. Priority decides which appointment the bar
# picks when two run at once: the lower number wins.
#
# The default is a single neutral grey, because a calendar named after someone
# else's company means nothing here. Name your own in the config file:
#
#   { "calendars": [ { "match": "Work", "color": "#4a9eff", "priority": 1 } ] }
#
# `match` is a regular expression, tried in order against the calendar name.
DEFAULT_STYLE = {"color": "#9aa0a6", "priority": 4}

CALENDAR_STYLES = []
for entry in (CONFIG.get("calendars") or []):
    try:
        CALENDAR_STYLES.append({
            "match": re.compile(str(entry.get("match", ""))),
            "color": entry.get("color") or DEFAULT_STYLE["color"],
            "priority": entry.get("priority") or DEFAULT_STYLE["priority"],
        })
    except re.error:
        continue

# One colleague's calendar you can flip to, to see their day instead of your
# own. Without one configured the panel leaves the toggle out entirely.
#
#   { "borrowedCalendar": { "name": "Sam - Work", "label": "Sam's calendar" } }
BORROWED_CALENDAR = None
_borrowed = CONFIG.get("borrowedCalendar")
if isinstance(_borrowed, dict) and str(_borrowed.get("name") or ""):
    BORROWED_CALENDAR = {
        "name": _borrowed["name"],
        "label": _borrowed.get("label") or _borrowed["name"],
    }

# Someone else's agenda gets the neutral grey rather than a colour of its own.
# Their work appointments would otherwise get the same blue as yours, and then
# it reads as your own day; black fell so far back that the blocks stopped
# being visible at all.
BORROWED_STYLE = {"color": "#9aa0a6", "priority": 4}


def style_for(calendar):
    if ONLY_CALENDAR:
        return BORROWED_STYLE

    # Without a config the demo would be three shades of the same grey, which
    # says nothing about what the colours are for.
    styles = DEMO_CALENDARS if (not CALENDAR_STYLES and DEMO) else CALENDAR_STYLES
    for style in styles:
        if style["match"].search(str(calendar or "")):
            return style
    return DEFAULT_STYLE


