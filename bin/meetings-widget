# One all-day event, on the Thursday, so the strip above the grid is not empty
# in a screenshot.
DEMO_ALLDAY = {"weekday": 3, "title": "Release day", "calendar": "Shared"}


def demo_slug(title):
    return re.sub(r"[^a-z0-9]+", "-", title.lower())


def demo_rows(from_day, to_day):
    rows = []
    day = from_day
    while day <= to_day:
        stamp = day.strftime("%Y-%m-%d")

        for start_time, end_time, title, calendar in DEMO_WEEK.get(day.weekday(), []):
            row = dict(DEMO_DETAILS.get(title, {}))
            row.update({
                "id": "demo-" + stamp + "-" + demo_slug(title),
                "start_date": stamp, "start_time": start_time,
                "end_date": stamp, "end_time": end_time,
                "title": title, "calendar": calendar,
                "hangout_link": "",
                "html_link": (("https://outlook.office.com/calendar/item/demo"
                               if PROVIDER == "microsoft" else
                               "https://calendar.google.com/calendar/event?eid=demo")
                              if title in DEMO_MEET else ""),
                "conference_uri": (("https://teams.microsoft.com/l/meetup-join/demo"
                                    if PROVIDER == "microsoft" else
                                    "https://meet.google.com/abc-defg-hij")
                                   if title in DEMO_MEET else ""),
            })
            rows.append(row)

        if day.weekday() == DEMO_ALLDAY["weekday"]:
            rows.append({
                "id": "demo-" + stamp + "-" + demo_slug(DEMO_ALLDAY["title"]),
                "start_date": stamp, "start_time": "",
                # gcalcli reports the end date exclusive, so an all-day event
                # that runs for one day ends on the next.
                "end_date": (day + timedelta(days=1)).strftime("%Y-%m-%d"), "end_time": "",
                "title": DEMO_ALLDAY["title"], "calendar": DEMO_ALLDAY["calendar"],
                "html_link": "", "hangout_link": "", "conference_uri": "",
            })

        day += timedelta(days=1)
    return rows


def parse_google_rows(from_day, to_day):
    """Read the columns by name rather than by position: the order shifts with
    every --details that gets added, and then everything silently shifts along
    with it. Without an explicit range, gcalcli agenda starts at now, so
    yesterday simply does not exist and paging back gives an empty day. The
    range runs to the day after, because gcalcli treats the end as exclusive."""
    command = ["gcalcli", "agenda", "--tsv", "--nodeclined", "--details", "all",
               from_day.strftime("%Y-%m-%d"),
               (to_day + timedelta(days=1)).strftime("%Y-%m-%d")]
    # stdin closed inside run_capped: gcalcli falls back to asking questions
    # when it can, and nothing here is ever in a position to answer one.
    out = run_capped(command)
    if out is None:
        return None

    lines = out.splitlines()
    if not lines:
        return []

    headers = lines[0].split("\t")
    return [dict(zip(headers, line.split("\t"))) for line in lines[1:]]


_ical_raw = None
_ical_checked = False


def read_ical_source():
    """The feed, read through the same ceiling every other source goes through.

    A calendar is kilobytes, so the ceiling is generous and anything past it
    means the source is broken or hostile. Overflow fails closed rather than
    handing back the first eight megabytes: half a feed parses into a
    plausible week that is missing appointments, which is worse than no week
    at all.
    """
    global _ical_raw, _ical_checked
    if _ical_checked:
        return _ical_raw
    _ical_checked = True
    if not ICAL_PATH:
        return None
    path = ICAL_PATH[7:] if ICAL_PATH.startswith("file://") else ICAL_PATH
    if path.startswith(("http://", "https://", "webcal://")):
        # A subscribed feed URL is the whole credential: anyone holding it
        # reads the calendar. Over http it crosses the network in the clear,
        # so that scheme is refused rather than quietly downgraded. webcal is
        # the same URL under another name and becomes https.
        if path.startswith("http://"):
            return None
        url = "https://" + path[9:] if path.startswith("webcal://") else path
        try:
            with urlopen(url, timeout=ICAL_TIMEOUT_SECONDS) as response:
                data = response.read(MAX_CLI_BYTES + 1)
        except (OSError, URLError):
            return None
        if len(data) > MAX_CLI_BYTES:
            return None
        _ical_raw = data.decode("utf-8", errors="replace")
        return _ical_raw
    # Binary, then decode: read() on a text stream counts characters rather
    # than bytes, so a ceiling checked against it lets a multibyte file through
    # at several times the size it is supposed to stop at.
    try:
        with open(path, "rb") as handle:
            data = handle.read(MAX_CLI_BYTES + 1)
    except OSError:
        return None
    if len(data) > MAX_CLI_BYTES:
        return None
    _ical_raw = data.decode("utf-8", errors="replace")
    return _ical_raw


def ical_unfold(raw):
    lines = []
    for line in raw.splitlines():
        if line.startswith((" ", "\t")) and lines:
            lines[-1] += line[1:]
        else:
            lines.append(line.rstrip("\r"))
    return lines


def ical_unescape(value):
    return (value.replace("\\n", "\n").replace("\\N", "\n")
                 .replace("\\;", ";").replace("\\,", ",")
                 .replace("\\\\", "\\"))


def ical_property(line):
    if ":" not in line:
        return None, {}, ""
    head, value = line.split(":", 1)
    pieces = head.split(";")
    params = {}
    for piece in pieces[1:]:
        if "=" in piece:
            key, param = piece.split("=", 1)
            params[key.upper()] = param.strip('"')
    return pieces[0].upper(), params, ical_unescape(value)


def parse_ics_datetime(value, params=None, convert_to_local=True):
    """Return an iCalendar value as local wall time without discarding its zone."""
    text = str(value or "").strip()
    params = params or {}
    if not text:
        return None
    if re.fullmatch(r"\d{8}", text):
        return datetime.strptime(text, "%Y%m%d")

    match = re.fullmatch(r"(\d{8}T\d{4}(?:\d{2})?)(Z|[+-]\d{4})?", text)
    if not match:
        return None
    stamp, suffix = match.groups()
    pattern = "%Y%m%dT%H%M%S" if len(stamp) == 15 else "%Y%m%dT%H%M"
    parsed = datetime.strptime(stamp, pattern)
    if suffix == "Z":
        parsed = parsed.replace(tzinfo=timezone.utc)
    elif suffix:
        parsed = parsed.replace(tzinfo=datetime.strptime(suffix, "%z").tzinfo)
    elif params.get("TZID"):
        try:
            parsed = parsed.replace(tzinfo=ZoneInfo(params["TZID"]))
        except (ValueError, ZoneInfoNotFoundError):
            pass
    if convert_to_local and parsed.tzinfo is not None:
        parsed = parsed.astimezone().replace(tzinfo=None)
    return parsed


def local_ical_datetime(value):
    return value.astimezone().replace(tzinfo=None) if value.tzinfo is not None else value


def ical_calendar_name(lines):
    for line in lines:
        name, _params, value = ical_property(line)
        if name == "X-WR-CALNAME" and value.strip():
            return value.strip()
    return "iCalendar"


def ical_attendees(lines):
    people = []
    for line in lines:
        name, params, value = ical_property(line)
        if name != "ATTENDEE":
            continue
        email = value[7:] if value.lower().startswith("mailto:") else value
        display = params.get("CN") or email
        if display:
            people.append({
                "name": display,
                "email": email,
                "status": params.get("PARTSTAT", "").lower(),
            })
    return people


WEEKDAYS = {"MO": 0, "TU": 1, "WE": 2, "TH": 3,
            "FR": 4, "SA": 5, "SU": 6}


def parse_rrule(value):
    rule = {}
    for piece in str(value or "").split(";"):
        if "=" in piece:
            key, item = piece.split("=", 1)
            rule[key.upper()] = item.upper()
    return rule


def recurrence_starts(start, rule, from_day, to_day):
    """Expand the daily and weekly rules used by subscribed meeting feeds."""
    frequency = rule.get("FREQ")
    if frequency not in ("DAILY", "WEEKLY"):
        return [start]
    try:
        interval = max(1, int(rule.get("INTERVAL", "1")))
        count_limit = max(1, int(rule["COUNT"])) if "COUNT" in rule else None
    except ValueError:
        return [start]
    until = parse_ics_datetime(rule.get("UNTIL")) if rule.get("UNTIL") else None
    starts = []
    emitted = 0

    if frequency == "DAILY":
        candidate = start
        while emitted < 20000:
            local_candidate = local_ical_datetime(candidate)
            if local_candidate.date() > to_day or (until and local_candidate > until):
                break
            emitted += 1
            if count_limit is not None and emitted > count_limit:
                break
            if local_candidate.date() >= from_day:
                starts.append(candidate)
            candidate += timedelta(days=interval)
        return starts

    weekdays = [WEEKDAYS[item] for item in rule.get("BYDAY", "").split(",")
                if item in WEEKDAYS]
    if not weekdays:
        weekdays = [start.weekday()]
    weekdays.sort()
    week = start.date() - timedelta(days=start.weekday())
    while emitted < 20000:
        for weekday in weekdays:
            candidate = datetime.combine(week + timedelta(days=weekday), start.timetz())
            if candidate < start:
                continue
            local_candidate = local_ical_datetime(candidate)
            if local_candidate.date() > to_day or (until and local_candidate > until):
                return starts
            emitted += 1
            if count_limit is not None and emitted > count_limit:
                return starts
            if local_candidate.date() >= from_day:
                starts.append(candidate)
        week += timedelta(weeks=interval)
    return starts


def ical_event_rows(lines, calendar_name, from_day, to_day):
    props = {}
    repeated = {}
    for line in lines:
        name, params, value = ical_property(line)
        if not name:
            continue
        if name in ("ATTENDEE", "EXDATE"):
            repeated.setdefault(name, []).append((params, value))
        else:
            props[name] = (params, value)

    title = (props.get("SUMMARY") or ({}, ""))[1].strip()
    start_prop = props.get("DTSTART")
    end_prop = props.get("DTEND")
    if not title or not start_prop or not end_prop:
        return []
    start = parse_ics_datetime(start_prop[1], start_prop[0], convert_to_local=False)
    end = parse_ics_datetime(end_prop[1], end_prop[0], convert_to_local=False)
    if start is None or end is None or end < start:
        return []
    duration = end - start
    excluded = set()
    for params, values in repeated.get("EXDATE", []):
        for value in values.split(","):
            parsed = parse_ics_datetime(value, params)
            if parsed is not None:
                excluded.add(parsed)
    starts = [start]
    if "RRULE" in props:
        starts = recurrence_starts(start, parse_rrule(props["RRULE"][1]), from_day, to_day)

    uid = (props.get("UID") or ({}, ""))[1]
    organizer = (props.get("ORGANIZER") or ({}, ""))[1]
    if organizer.lower().startswith("mailto:"):
        organizer = organizer[7:]
    all_day = start_prop[0].get("VALUE") == "DATE" or "T" not in start_prop[1]
    attendees = ical_attendees(lines)
    rows = []
    for source_occurrence in starts:
        occurrence = local_ical_datetime(source_occurrence)
        if occurrence in excluded:
            continue
        occurrence_end = local_ical_datetime(source_occurrence + duration)
        if occurrence_end.date() < from_day or occurrence.date() > to_day:
            continue
        rows.append({
            "id": uid or "ical-%s-%s" % (occurrence.isoformat(), title),
            "start_date": occurrence.strftime("%Y-%m-%d"),
            "start_time": "" if all_day else occurrence.strftime("%H:%M"),
            "end_date": occurrence_end.strftime("%Y-%m-%d"),
            "end_time": "" if all_day else occurrence_end.strftime("%H:%M"),
            "title": title,
            "calendar": calendar_name,
            "html_link": (props.get("URL") or ({}, ""))[1],
            "conference_uri": "",
            "location": (props.get("LOCATION") or ({}, ""))[1],
            "description": (props.get("DESCRIPTION") or ({}, ""))[1],
            "email": organizer,
            "attendees": attendees,
        })
    return rows


def parse_ical_rows(from_day, to_day):
    raw = read_ical_source()
    if raw is None:
        return None
    lines = ical_unfold(raw)
    calendar_name = ical_calendar_name(lines)
    rows = []
    event = None
    for line in lines:
        if line == "BEGIN:VEVENT":
            event = []
        elif line == "END:VEVENT" and event is not None:
            rows.extend(ical_event_rows(event, calendar_name, from_day, to_day))
            event = None
        elif event is not None:
            event.append(line)
    return rows


def graph_url_allowed(url):
    """Never let an authenticated m365 request leave Microsoft Graph."""
    try:
        parsed = urlsplit(str(url))
        port = parsed.port
    except (TypeError, ValueError):
        return False
    return (parsed.scheme == "https"
            and parsed.hostname == "graph.microsoft.com"
            and parsed.username is None
            and parsed.password is None
            and port in (None, 443))


def graph_request(url, method=None, body=None, prefer=None):
    if not graph_url_allowed(url):
        return None
    command = ["m365", "request", "--url", url, "--output", "json"]
    if method:
        command.extend(["--method", method])
    if body is not None:
        command.extend(["--body", json.dumps(body), "--content-type", "application/json"])
    if prefer:
        command.extend(["--prefer", prefer])
    return run_json(command)


def graph_pages(url, prefer=None):
    """Follow Graph pagination without ever handing a URL to a shell."""
    items = []
    next_url = url
    for _ in range(50):
        page = graph_request(next_url, prefer=prefer)
        if not isinstance(page, dict) or not isinstance(page.get("value"), list):
            return None
        items.extend(page["value"])
        next_url = page.get("@odata.nextLink")
        if not next_url:
            return items
    return None


def graph_datetime(value):
    """Turn Graph's default UTC dateTimeTimeZone into local wall time."""
    if not isinstance(value, dict):
        return None
    raw = str(value.get("dateTime") or "")
    if not raw:
        return None
    try:
        parsed = datetime.fromisoformat(raw.replace("Z", "+00:00"))
    except ValueError:
        return None
    if parsed.tzinfo is None:
        zone_name = str(value.get("timeZone") or "UTC")
        try:
            parsed = parsed.replace(tzinfo=ZoneInfo(zone_name))
        except (ValueError, ZoneInfoNotFoundError):
            parsed = parsed.replace(tzinfo=timezone.utc)
    return parsed.astimezone()


def microsoft_row(event, calendar_name):
    if (not isinstance(event, dict) or event.get("isCancelled")
            or (event.get("responseStatus") or {}).get("response") == "declined"):
        return None
    title = str(event.get("subject") or "")
    starts = graph_datetime(event.get("start"))
    ends = graph_datetime(event.get("end"))
    if not title or starts is None or ends is None:
        return None

    all_day = event.get("isAllDay") is True
    if all_day:
        # All-day values describe calendar dates. Converting their midnight
        # through UTC can move them to yesterday in a western timezone.
        start_date = str((event.get("start") or {}).get("dateTime") or "")[:10]
        end_date = str((event.get("end") or {}).get("dateTime") or "")[:10]
        start_time = end_time = ""
    else:
        start_date, start_time = starts.strftime("%Y-%m-%d"), starts.strftime("%H:%M")
        end_date, end_time = ends.strftime("%Y-%m-%d"), ends.strftime("%H:%M")

    location = event.get("location") or {}
    organizer = (event.get("organizer") or {}).get("emailAddress") or {}
    meeting = event.get("onlineMeeting") or {}
    return {
        "id": str(event.get("id") or ""),
        "start_date": start_date,
        "start_time": start_time,
        "end_date": end_date,
        "end_time": end_time,
        "title": title,
        "calendar": calendar_name,
        "html_link": str(event.get("webLink") or ""),
        "conference_uri": str(meeting.get("joinUrl") or event.get("onlineMeetingUrl") or ""),
        "location": str(location.get("displayName") or ""),
        "description": str(event.get("bodyPreview") or ""),
        "email": str(organizer.get("address") or ""),
    }


def local_range(from_day, to_day):
    starts = datetime.combine(from_day, time.min).astimezone()
    ends = datetime.combine(to_day + timedelta(days=1), time.min).astimezone()
    return starts.isoformat(), ends.isoformat()


def parse_microsoft_rows(from_day, to_day):
    records = cached_calendar_records()
    if records is None:
        return None

    wanted = []
    for record in records:
        name = record["name"]
        if ONLY_CALENDAR and name != ONLY_CALENDAR:
            continue
        if not ONLY_CALENDAR and VISIBLE is not None and name not in VISIBLE:
            continue
        if not ONLY_CALENDAR and VISIBLE is None and name in SKIP_CALENDARS:
            continue
        wanted.append(record)

    range_start, range_end = local_range(from_day, to_day)
    properties = ("id,subject,start,end,isAllDay,isCancelled,webLink,"
                  "onlineMeeting,onlineMeetingUrl,location,bodyPreview,organizer,"
                  "responseStatus")
    rows = []
    # Graph batching keeps a refresh to one m365 process for up to twenty
    # calendars instead of starting the Node CLI once per calendar.
    for batch_start in range(0, len(wanted), 20):
        batch_records = wanted[batch_start:batch_start + 20]
        requests = []
        record_by_id = {}
        for index, record in enumerate(batch_records):
            request_id = str(index + 1)
            record_by_id[request_id] = record
            calendar_id = quote(record["id"], safe="")
            query = urlencode({
                "startDateTime": range_start,
                "endDateTime": range_end,
                "$select": properties,
                "$top": "1000",
            })
            requests.append({
                "id": request_id,
                "method": "GET",
                "url": "/me/calendars/%s/calendarView?%s" % (calendar_id, query),
                "headers": {"Prefer": 'outlook.timezone="%s"' % LOCAL_TIMEZONE},
            })

        batch = graph_request("https://graph.microsoft.com/v1.0/$batch",
                              method="post", body={"requests": requests})
        if not isinstance(batch, dict) or not isinstance(batch.get("responses"), list):
            return None
        responses = {str(response.get("id")): response for response in batch["responses"]
                     if isinstance(response, dict)}
        for request_id, record in record_by_id.items():
            response = responses.get(request_id) or {}
            body = response.get("body") or {}
            if response.get("status") != 200 or not isinstance(body.get("value"), list):
                return None
            events = list(body["value"])
            next_url = body.get("@odata.nextLink")
            if next_url:
                following = graph_pages(
                    next_url, prefer='outlook.timezone="%s"' % LOCAL_TIMEZONE)
                if following is None:
                    return None
                events.extend(following)
            rows.extend(row for row in (microsoft_row(event, record["name"])
                                        for event in events) if row)
    return rows


def parse_rows(from_day, to_day):
    if DEMO:
        return demo_rows(from_day, to_day)
    if PROVIDER == "microsoft":
        if shutil.which("m365") is None:
            return None
        return parse_microsoft_rows(from_day, to_day)
    if PROVIDER == "ical":
        return parse_ical_rows(from_day, to_day)
    if not authenticated():
        return None
    return parse_google_rows(from_day, to_day)


def parse_attendees(value):
    """Attendees do not come out of gcalcli's tsv; the demo supplies them, and a
    later source can fill the same field. Anything that is not a list is ignored
    rather than shown half-way."""
    if not isinstance(value, list):
        return []

    people = []
    for entry in value:
        if isinstance(entry, str):
            people.append({"name": entry, "email": "", "status": ""})
            continue
        if not isinstance(entry, dict):
            continue
        name = str(entry.get("name") or entry.get("email") or "")
        if not name:
            continue
        people.append({
            "name": name,
            "email": str(entry.get("email") or ""),
            "status": str(entry.get("status") or ""),
        })
    return people


def event_from(row, day):
    start_date = row.get("start_date")
    start_time = row.get("start_time")
    end_date = row.get("end_date")
    end_time = row.get("end_time")
    title = row.get("title")
    calendar = row.get("calendar")

    # html_link carries the eid Google uses itself, so there is nothing to
    # rebuild out of the event and calendar ids.
    link = str(row.get("html_link") or "")
    # The conference uri is the meeting link when there is no separate hangout
    # field: the older Hangouts link and the newer Meet conference sit in
    # different columns.
    hangout = str(row.get("hangout_link") or "") or str(row.get("conference_uri") or "")

    # What the detail card shows. Empty stays empty: a heading with nothing
    # under it is worse than no heading.
    details = {
        "id": str(row.get("id") or ""),
        "location": str(row.get("location") or ""),
        "description": str(row.get("description") or ""),
        "organizer": str(row.get("email") or ""),
        "attendees": parse_attendees(row.get("attendees")),
        "attendees_embedded": isinstance(row.get("attendees"), list),
    }

    if not title:
        return None
    if title in SKIP_TITLES:
        return None

    if ONLY_CALENDAR:
        if str(calendar or "") != ONLY_CALENDAR:
            return None
    elif VISIBLE is not None:
        # Your own choice in the panel is the whole answer. Two filters side by
        # side would mean that ticking a calendar does nothing at all, and that
        # cannot be explained to anyone looking at the list.
        if str(calendar or "") not in VISIBLE:
            return None
    elif calendar in SKIP_CALENDARS:
        return None

    style = style_for(calendar)

    # All-day events have no time and often run across several days. gcalcli
    # gives the end date exclusive, just as the Google API does.
    if not start_time:
        first = date.fromisoformat(start_date)
        last = date.fromisoformat(end_date) - timedelta(days=1)
        if not (first <= day <= last):
            return None

        event = {
            "allday": True, "title": title, "calendar": calendar,
            "color": style["color"], "priority": style["priority"],
            "multiday": first != last,
            "link": link,
        }
        event.update(details)
        return event

    starts = datetime.strptime("%s %s" % (start_date, start_time), "%Y-%m-%d %H:%M")
    ends = datetime.strptime("%s %s" % (end_date, end_time), "%Y-%m-%d %H:%M")
    if starts.date() != day:
        return None

    event = {
        "allday": False,
        "title": title,
        "calendar": calendar,
        "color": style["color"],
        "priority": style["priority"],
        "start": starts.strftime("%H:%M"),
        "end": ends.strftime("%H:%M"),
        "start_minutes": starts.hour * 60 + starts.minute,
        "end_minutes": ends.hour * 60 + ends.minute,
        "start_epoch": int(starts.timestamp()),
        "end_epoch": int(ends.timestamp()),
        "link": link,
        "hangout": hangout,
        "minutes": round((ends - starts).total_seconds() / 60),
    }
    event.update(details)
    return event


def assign_columns(events):
    """Overlapping appointments side by side, the way a calendar does it.
    Without this they draw on top of each other and everything inside a long
    appointment disappears: a working day from 09:00 to 18:00 swallows the four
    meetings that sit within it.

    Cluster on overlap first, then take the first free column within a cluster.
    Every event carries its column and the cluster total, so the widget only
    has to divide."""
    cluster = []
    cluster_end = None

    def flush():
        columns = []
        for event in cluster:
            slot = next((i for i, free_at in enumerate(columns)
                         if free_at <= event["start_minutes"]), None)
            if slot is None:
                columns.append(event["end_minutes"])
                slot = len(columns) - 1
            else:
                columns[slot] = event["end_minutes"]
            event["column"] = slot
        for event in cluster:
            event["columns"] = len(columns)
        cluster.clear()

    for event in events:
        if cluster_end is None or event["start_minutes"] < cluster_end:
            cluster.append(event)
            cluster_end = max(cluster_end or 0, event["end_minutes"])
        else:
            flush()
            cluster.append(event)
            cluster_end = event["end_minutes"]
    flush()

    return events


def calendar_url(day, mode):
    if PROVIDER == "microsoft":
        return "https://outlook.office.com/calendar/view/%s" % mode
    if PROVIDER == "ical":
        return ""
    path = "%d/%d/%d" % (day.year, day.month, day.day)
    return "https://calendar.google.com/calendar/u/0/r/%s/%s" % (mode, path)


def build_day(rows, day):
    """One day, assembled from the rows of the whole requested range."""
    parsed = [event for event in (event_from(row, day) for row in rows) if event]

    # Deduplicate on title plus start time: the same appointment often sits in
    # two calendars that you are both looking at.
    seen = set()
    timed = []
    for event in parsed:
        if event["allday"]:
            continue
        key = "%s|%s" % (event["title"], event["start_epoch"])
        if key in seen:
            continue
        seen.add(key)
        timed.append(event)
    timed.sort(key=lambda e: e["start_minutes"])

    return {
        # Without leading zeroes, because that is how Google Calendar wants it
        # in its url.
        "date_path": "%d/%d/%d" % (day.year, day.month, day.day),
        "calendar_url": calendar_url(day, "day"),
        "date_label": day.strftime("%A %-d %B"),
        "short_label": day.strftime("%a %-d"),
        "is_today": day == date.today(),
        "events": assign_columns(timed),
        "allday": [event for event in parsed if event["allday"]],
    }


def upcoming_from(timed, now):
    """What the bar shows. A running appointment comes first, then the next one;
    on a tie the calendar with the highest priority wins. Only about today:
    paging a day back or forward does not change the bar."""
    stamp = int(now.timestamp())
    live = [e for e in timed if e["start_epoch"] <= stamp < e["end_epoch"]]
    if live:
        return min(live, key=lambda e: (e["priority"], e["start_epoch"]))
    ahead = [e for e in timed if e["start_epoch"] > stamp]
    if ahead:
        return min(ahead, key=lambda e: (e["start_epoch"], e["priority"]))
    return None


# The list of calendars changes about never, and asking gcalcli for it on every
# refresh would mean a second process every minute. An hour old is fresh enough.
CACHE_PATH = home_path("XDG_CACHE_HOME", ".cache", "omarchy-meetings", "calendars.json")
CACHE_MAX_AGE = 3600

DEMO_CALENDAR_NAMES = ["Work", "Personal", "Shared"]


# gcalcli colours its table even when nobody is watching, and those escapes
# are the first thing on every line. Read as text they look like the first
# column, which turned every calendar name into "owner <name>" and let the
# header through as a calendar of its own.
ANSI = re.compile(r"\x1b\[[0-9;]*[A-Za-z]")


def fetch_google_calendars():
    """gcalcli prints a table: a header, a rule of dashes, then one row per
    calendar with the access level first and the title filling the rest."""
    out = run_capped(["gcalcli", "list"])
    if out is None:
        return None

    names = []
    for raw in out.splitlines():
        line = ANSI.sub("", raw)
        match = re.match(r"\A\s*\S+\s+(\S.*?)\s*\Z", line)
        if not match:
            continue
        title = match.group(1)
        if title == "Title" or re.match(r"\A-+\Z", title):
            continue
        names.append(title)
    return [{"id": title, "name": title} for title in names]


def fetch_microsoft_calendars():
    query = urlencode({"$select": "id,name", "$top": "1000"})
    items = graph_pages("https://graph.microsoft.com/v1.0/me/calendars?" + query)
    if items is None:
        return None
    records = []
    for entry in items:
        if not isinstance(entry, dict):
            continue
        calendar_id = str(entry.get("id") or "")
        name = str(entry.get("name") or "")
        if calendar_id and name:
            records.append({"id": calendar_id, "name": name})
    return records


def fetch_calendar_records():
    if DEMO:
        return [{"id": name, "name": name} for name in DEMO_CALENDAR_NAMES]
    if PROVIDER == "microsoft":
        return fetch_microsoft_calendars()
    if PROVIDER == "ical":
        raw = read_ical_source()
        if raw is None:
            return None
        name = ical_calendar_name(ical_unfold(raw))
        return [{"id": name, "name": name}]
    if not authenticated():
        return None
    return fetch_google_calendars()


def cached_calendar_records():
    """A cache must never be the thing that breaks the script, so anything that
    is not the shape we wrote is treated as no cache at all."""
    try:
        if (os.path.isfile(CACHE_PATH) and not os.path.islink(CACHE_PATH)
                and (datetime.now().timestamp() - os.path.getmtime(CACHE_PATH)) < CACHE_MAX_AGE):
            parsed = read_json(CACHE_PATH, None)
            if (isinstance(parsed, dict) and parsed.get("provider") == PROVIDER
                    and isinstance(parsed.get("calendars"), list)):
                records = []
                for entry in parsed["calendars"]:
                    if not isinstance(entry, dict):
                        continue
                    calendar_id = str(entry.get("id") or "")
                    name = str(entry.get("name") or "")
                    if calendar_id and name:
                        records.append({"id": calendar_id, "name": name})
                if records:
                    return records
    except OSError:
        pass  # fall through and ask the provider again

    fresh = fetch_calendar_records()
    if fresh is None:
        return None
    if not fresh:
        return []

    write_private(CACHE_PATH, json.dumps({"provider": PROVIDER, "calendars": fresh}))
    return fresh


def cached_calendars():
    records = cached_calendar_records()
    return [record["name"] for record in records] if records is not None else []


MICROSOFT_STATUSES = {
    "accepted": "accepted",
    "declined": "declined",
    "tentativelyAccepted": "tentative",
    "organizer": "accepted",
    "none": "needsAction",
    "notResponded": "needsAction",
}


def microsoft_attendees(calendar_name, event_id):
    records = cached_calendar_records() or []
    record = next((entry for entry in records if entry["name"] == calendar_name), None)
    if record is None:
        return []
    calendar_id = quote(record["id"], safe="")
    encoded_event = quote(event_id, safe="")
    query = urlencode({"$select": "attendees"})
    url = ("https://graph.microsoft.com/v1.0/me/calendars/%s/events/%s?%s" %
           (calendar_id, encoded_event, query))
    event = graph_request(url)
    if not isinstance(event, dict):
        return []

    people = []
    for attendee in event.get("attendees") or []:
        if not isinstance(attendee, dict):
            continue
        address = attendee.get("emailAddress") or {}
        name = str(address.get("name") or address.get("address") or "")
        if not name:
            continue
        response = str((attendee.get("status") or {}).get("response") or "")
        people.append({
            "name": name,
            "email": str(address.get("address") or ""),
            "status": MICROSOFT_STATUSES.get(response, response),
        })
    return people


def dump(payload):
    sys.stdout.write(json.dumps(payload) + "\n")


def main():
    # Two commands the panel calls directly, both outside the agenda path.
    command = ARGV[0] if ARGV else ""

    if command == "calendars":
        dump(cached_calendars())
        return 0

    if command == "attendees":
        # One appointment, asked for at the moment you open it. Not on every
        # refresh: that would be an API call a minute for something you only
        # ever see when you ask for it.
        calendar_name = ARGV[1] if len(ARGV) > 1 else ""
        event_id = ARGV[2] if len(ARGV) > 2 else ""

        if DEMO:
            for title, details in DEMO_DETAILS.items():
                if event_id.endswith("-" + demo_slug(title)):
                    dump(parse_attendees(details.get("attendees")))
                    return 0
            dump([])
            return 0

        if not event_id or not calendar_name:
            dump([])
            return 0

        if PROVIDER == "microsoft":
            dump(microsoft_attendees(calendar_name, event_id))
            return 0

        if PROVIDER == "ical":
            # iCalendar attendees are embedded in the agenda payload, so the
            # panel never needs a second read (or download) for this command.
            dump([])
            return 0

        helper = os.path.join(os.path.dirname(os.path.abspath(__file__)), "meetings-attendees")
        # The argument list goes straight to the process, so no shell is
        # involved that could split a calendar name with a space in it, and
        # run_capped bounds what comes back in bytes and in seconds.
        out = run_capped([helper, calendar_name, event_id])
        sys.stdout.write(out if out and out.strip() else "[]\n")
        return 0

    if command == "set-view":
        wanted = "day" if (len(ARGV) > 1 and ARGV[1] == "day") else "week"
        merged = dict(STATE)
        merged["view"] = wanted
        dump({"ok": write_private(STATE_PATH, json.dumps(merged)), "view": wanted})
        return 0

    if command == "set-calendars":
        # Everything after the command is a calendar name. An empty list would
        # mean an empty grid with no way back from the panel, so it is stored as
        # "all of them" instead, which is also what a fresh install shows.
        chosen = [name for name in ARGV[1:] if name]
        merged = dict(STATE)
        merged["visibleCalendars"] = chosen
        ok = write_private(STATE_PATH, json.dumps(merged))
        dump({"ok": ok, "visible": chosen or None})
        return 0

    mode = "week" if command == "week" else "day"
    second = ARGV[1] if len(ARGV) > 1 else ""
    try:
        offset = 0 if second.startswith("--") else int(second or 0)
    except ValueError:
        offset = 0
    now = datetime.now()
    today = date.today()

    # In week mode the offset counts in weeks and the week starts on Monday,
    # the way Google Calendar does it.
    if mode == "week":
        monday = today - timedelta(days=today.weekday()) + timedelta(days=offset * 7)
        days = [monday + timedelta(days=n) for n in range(7)]
    else:
        days = [today + timedelta(days=offset)]

    rows = parse_rows(days[0], days[-1])
    if rows is None:
        # Two different problems that need two different answers: one is fixed
        # by installing something, the other by logging in.
        command_name = required_command()
        missing = (not ICAL_PATH if PROVIDER == "ical"
                   else shutil.which(command_name) is None)
        payload = provider_payload()
        payload.update({
            "ok": False,
            "error": ("ical-path-missing" if PROVIDER == "ical" and missing else
                      ("ical-insecure" if PROVIDER == "ical" and ICAL_PATH.startswith("http://") else
                      ("ical-unavailable" if PROVIDER == "ical" else
                      ("%s-missing" % command_name if missing else
                      ("not-authenticated" if not authenticated() else
                       "%s-failed" % command_name))))),
            "events": [], "allday": [], "days": [],
        })
        dump(payload)
        return 0

    built = [build_day(rows, day) for day in days]
    today_built = next((d for d in built if d["is_today"]), None)

    # The bar is always about today and about your own calendar; paging around,
    # or looking at someone else's week, must not change it.
    upcoming = (upcoming_from(today_built["events"], now)
                if ONLY_CALENDAR is None and today_built else None)

    known = cached_calendars()
    payload = {
        "ok": True,
        "mode": mode,
        "offset": offset,
        "only_calendar": ONLY_CALENDAR,
        # The panel needs to know whether there is a colleague's calendar to
        # borrow before it can decide whether to draw the toggle for it, and the
        # config file is the only place that knows. Sending it along beats
        # teaching the QML to read the file a second time.
        "borrowed": BORROWED_CALENDAR,
        # The panel draws the calendar picker from these two: everything there
        # is, and what is ticked. A null selection means nothing has been
        # unticked yet, and the panel then shows them all as on.
        "calendars": known,
        # With no choice of your own the starting position is everything except
        # what the config skips, and that is exactly what the boxes have to show.
        "visible": VISIBLE if VISIBLE is not None
                   else [name for name in known if name not in SKIP_CALENDARS],
        "view": VIEW,
        "now": now.strftime("%H:%M"),
        "now_minutes": now.hour * 60 + now.minute,
        "upcoming": upcoming,
        "days": built,
    }
    payload.update(provider_payload())

    if mode == "week":
        # Google's week view uses the Monday as its anchor.
        payload["date_path"] = built[0]["date_path"]
        payload["date_label"] = "%s - %s" % (days[0].strftime("%-d %b"),
                                             days[-1].strftime("%-d %b"))
        payload["is_today"] = offset == 0
        payload["agenda_url"] = calendar_url(days[0], "week")
    else:
        for key in ("date_path", "date_label", "is_today", "events", "allday"):
            payload[key] = built[0][key]
        payload["agenda_url"] = calendar_url(days[0], "day")

    dump(payload)
    return 0


if __name__ == "__main__":
    sys.exit(main())
